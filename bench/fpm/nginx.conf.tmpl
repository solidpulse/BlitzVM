# Rendered by bench/run.sh. nginx runs natively when installed, else in Docker with host networking.
# No FastCGI keep-alive: with a small static pool an idle persistent connection pins a child.
worker_processes 2;
__MAIN__
events { worker_connections 1024; }
http {
  access_log off;
__HTTP__
  server {
    listen __HTTP_PORT__;
    root __ROOT__;
    index index.php index.html;
    # Front controller routing (WordPress pretty permalinks); www/ never reaches it.
    location / { try_files $uri $uri/ /index.php?$args; }
    location ~ \.php$ {
      fastcgi_pass 127.0.0.1:__FPM_PORT__;
      include /etc/nginx/fastcgi_params;
      fastcgi_param SCRIPT_FILENAME __WWW__$fastcgi_script_name;
    }
  }
}
