#!/usr/bin/env bash
# Launcher. Uses ./.graalvm if present (Graal JIT), else $JAVA_HOME. Without a GraalVM
# Truffle runs the same AST in interpreter-only mode on any JDK 21+.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ ! -d "$ROOT/target/classes" || ! -d "$ROOT/target/lib" ]]; then
  (cd "$ROOT" && mvn -q -B -DskipTests package) >&2
fi
# Prefer the GraalVM fetched by scripts/get-graalvm.sh (same AST, plus the Graal JIT),
# even if JAVA_HOME points elsewhere (sdkman sets it). PHP_TRUFFLE_JAVA_HOME overrides.
JAVA_HOME_USED="${PHP_TRUFFLE_JAVA_HOME:-}"
if [[ -z "$JAVA_HOME_USED" && -x "$ROOT/.graalvm/current/bin/java" ]]; then
  JAVA_HOME_USED="$ROOT/.graalvm/current"
fi
JAVA_HOME="${JAVA_HOME_USED:-${JAVA_HOME:-}}"
JAVA="${JAVA_HOME:+$JAVA_HOME/bin/}java"
# Truffle loads a native library and uses sun.misc.Unsafe; JDK 24+ warns about both.
JDK_FLAGS=(--enable-native-access=ALL-UNNAMED)
# The generated date scanners (timelib/DateScanner*.java) are large state machines; HotSpot
# skips JIT-compiling methods over 8000 bytes of bytecode unless this is off.
JDK_FLAGS+=(-XX:-DontCompileHugeMethods)
JDK_MAJOR="$(sed -n 's/^JAVA_VERSION="\([0-9]*\).*/\1/p' "${JAVA_HOME:-/nonexistent}/release" 2>/dev/null || true)"
if [[ -n "$JDK_MAJOR" && "$JDK_MAJOR" -ge 23 ]]; then
  JDK_FLAGS+=(--sun-misc-unsafe-memory-access=allow)
fi
exec "$JAVA" "${JDK_FLAGS[@]}" ${PHP_TRUFFLE_OPTS:-} \
  -Dpolyglot.engine.WarnInterpreterOnly=false \
  -cp "$ROOT/target/classes:$ROOT/target/lib/*" \
  dev.phpruntime.host.Main "$@"
